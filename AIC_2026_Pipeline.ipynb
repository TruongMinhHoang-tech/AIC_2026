    {
      "cell_type": "code",
      "source": [
        "import csv\n",
        "import re\n",
        "\n",
        "\n",
        "def load_ocr_data(csv_filepath):\n",
        "    ocr_data = []\n",
        "    with open(csv_filepath, 'r', encoding='utf-8-sig') as f:\n",
        "        for row in csv.DictReader(f):\n",
        "            ocr_data.append({\n",
        "                'video_id': row['video_id'],\n",
        "                'frame_id': row['frame_id'],\n",
        "                'text': row['text_doc_duoc']\n",
        "            })\n",
        "    return ocr_data\n",
        "\n",
        "\n",
        "def ocr_search(query: str, ocr_data: list, min_score=60):\n",
        "    results = []\n",
        "    query_clean = query.lower().strip()\n",
        "\n",
        "\n",
        "    query_words = set(query_clean.split())\n",
        "\n",
        "    for item in ocr_data:\n",
        "        text = item.get('text', '').lower()\n",
        "        if not text:\n",
        "            continue\n",
        "\n",
        "\n",
        "        if query_clean in text:\n",
        "            results.append((item['video_id'], item['frame_id'], 100.0, item['text']))\n",
        "            continue\n",
        "\n",
        "\n",
        "        if query_words:\n",
        "\n",
        "            text_words = set(text.replace('|', ' ').split())\n",
        "\n",
        "\n",
        "            matched_words = query_words.intersection(text_words)\n",
        "            score = (len(matched_words) / len(query_words)) * 100\n",
        "\n",
        "\n",
        "            if score >= min_score:\n",
        "                results.append((item['video_id'], item['frame_id'], score, item['text']))\n",
        "\n",
        "\n",
        "    results.sort(key=lambda x: x[2], reverse=True)\n",
        "    return results\n",
        "\n",
        "\n",
        "file_csv = "ĐƯỜNG DẪN FILE"\n",
        "\n",
        "\n",
        "tu_khoa = \"ĐIỀN TỪ KHOÁ"\"\n",
        "\n",
        "try:\n",
        "    du_lieu_ocr = load_ocr_data(file_csv)\n",
        "    print(f\"Đang tìm từ khóa: '{tu_khoa}'...\")\n",
        "\n",
        "\n",
        "    ket_qua = ocr_search(tu_khoa, du_lieu_ocr, min_score=50)\n",
        "\n",
        "    if not ket_qua:\n",
        "        print(\"Không tìm thấy khung hình nào phù hợp.\")\n",
        "    else:\n",
        "        print(f\"Tìm thấy {len(ket_qua)} kết quả phù hợp (Đã sắp xếp theo độ chính xác):\")\n",
        "        for idx, (vid, fid, score, text) in enumerate(ket_qua):\n",
        "\n",
        "            print(f\"\\n[{idx + 1}] Độ khớp {score:.0f}% | Video: {vid} - Frame: {fid}\")\n",
        "            print(f\"    >> Văn bản gốc: {text[:150]}...\")\n",
        "\n",
        "except FileNotFoundError:\n",
        "    print(f\"[LỖI]: Không tìm thấy file '{file_csv}'!\")"
      ],
