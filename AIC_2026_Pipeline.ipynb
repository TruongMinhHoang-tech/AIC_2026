    {
      "cell_type": "code",
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "from PIL import Image\n",
        "from paddleocr import PaddleOCR\n",
        "from vietocr.tool.predictor import Predictor\n",
        "from vietocr.tool.config import Cfg\n",
        "\n",
        "\n",
        "paddle_detector = PaddleOCR(use_angle_cls=True, lang='vi', rec=True, show_log=False, use_gpu=False, det_limit_side_len=1536, det_db_unclip_ratio=2.0)\n",
        "config = Cfg.load_config_from_name('vgg_transformer')\n",
        "config['device'] = 'cpu'\n",
        "viet_recognizer = Predictor(config)\n",
        "\n",
        "\n",
        "def extract_text_from_image(img_path):\n",
        "    img_cv = cv2.imread(img_path)\n",
        "    if img_cv is None:\n",
        "        return \"\"\n",
        "\n",
        "    boxes = paddle_detector.ocr(img_path, cls=True)\n",
        "    text_lines = []\n",
        "\n",
        "    if boxes and boxes[0] is not None:\n",
        "        for item in boxes[0]:\n",
        "            box, paddle_text = item[0], item[1][0]\n",
        "\n",
        "\n",
        "            if not any(char.isalpha() for char in paddle_text):\n",
        "                text_lines.append(paddle_text)\n",
        "            else:\n",
        "                x_coords, y_coords = [int(p[0]) for p in box], [int(p[1]) for p in box]\n",
        "                cropped_img = img_cv[min(y_coords):max(y_coords), min(x_coords):max(x_coords)]\n",
        "\n",
        "                if cropped_img.size > 0:\n",
        "\n",
        "                    gray = cv2.cvtColor(cropped_img, cv2.COLOR_BGR2GRAY)\n",
        "                    contrast_img = cv2.createCLAHE(clipLimit=1.0, tileGridSize=(8, 8)).apply(gray)\n",
        "                    final_cv_img = cv2.cvtColor(contrast_img, cv2.COLOR_GRAY2RGB)\n",
        "\n",
        "                    viet_text = viet_recognizer.predict(Image.fromarray(final_cv_img))\n",
        "                    text_lines.append(viet_text)\n",
        "\n",
        "    return \" | \".join(text_lines)\n",
        "\n"
      ],
      "metadata": {
        "id": "svMFGfS-JEBS"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import glob\n",
        "import csv\n",
        "\n",
        "\n",
        "folder_path = 'L21_V001'\n",
        "output_csv = f'ocr_results_{folder_path}.csv'\n",
        "video_id = os.path.basename(os.path.normpath(folder_path))\n",
        "\n",
        "\n",
        "image_list = glob.glob(os.path.join(folder_path, '*.[jp][pn]g'))\n",
        "print(f\"Bắt đầu quét {len(image_list)} ảnh từ Video {video_id}...\\n\")\n",
        "\n",
        "\n",
        "processed_frames = set()\n",
        "if os.path.isfile(output_csv):\n",
        "    with open(output_csv, 'r', encoding='utf-8-sig') as f:\n",
        "        reader = csv.reader(f)\n",
        "        next(reader, None)\n",
        "        for row in reader:\n",
        "            if len(row) >= 2:\n",
        "                processed_frames.add(row[1])\n",
        "\n",
        "\n",
        "with open(output_csv, 'a', newline='', encoding='utf-8-sig') as csvfile:\n",
        "    writer = csv.writer(csvfile)\n",
        "\n",
        "\n",
        "    if os.stat(output_csv).st_size == 0 if os.path.isfile(output_csv) else True:\n",
        "        writer.writerow(['video_id', 'frame_id', 'text_doc_duoc'])\n",
        "\n",
        "    for img_path in image_list:\n",
        "        frame_id = os.path.splitext(os.path.basename(img_path))[0]\n",
        "\n",
        "        if frame_id in processed_frames:\n",
        "            continue\n",
        "\n",
        "        print(f\" Đang quét: Frame [{frame_id}]\")\n",
        "\n",
        "\n",
        "        text_result = extract_text_from_image(img_path)\n",
        "\n",
        "\n",
        "        writer.writerow([video_id, frame_id, text_result])\n",
        "        csvfile.flush()\n",
        "\n",
        "print(f\"\\n HOÀN THÀNH! Đã lưu kết quả tại: {output_csv}\")"
      ],
      "metadata": {
        "id": "FgYTOKJsTH9R"
      },
